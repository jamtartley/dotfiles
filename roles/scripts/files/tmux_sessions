#!/usr/bin/env bash

set -euo pipefail

if [[ $# -gt 1 ]]; then
    echo "Usage: tmux_sessions [project-directory]" >&2
    exit 1
fi

if [[ $# -eq 1 ]]; then
    SELECTED=$1
else
    SELECTED=$(find "$HOME/dev" -mindepth 1 -maxdepth 1 -type d | sort | fzf --delimiter=/ --with-nth=-1) || exit 0
fi

if [[ -z $SELECTED ]]; then
    exit 0
fi

if [[ ! -d "$SELECTED" ]]; then
    echo "Project directory not found: $SELECTED" >&2
    exit 1
fi

SELECTED=$(cd -- "$SELECTED" && pwd -P)
SELECTED_NAME=$(basename "$SELECTED" | tr '.:' '__')

if ! tmux has-session -t "=$SELECTED_NAME" 2> /dev/null; then
    tmux new-session -ds "$SELECTED_NAME" -c "$SELECTED"
fi

if [[ -n ${TMUX:-} ]]; then
    exec tmux switch-client -t "=$SELECTED_NAME"
else
    exec tmux attach-session -t "=$SELECTED_NAME"
fi
