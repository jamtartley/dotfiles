#!/bin/bash

max_output_len=50

# Prefer a playing Spotify client, otherwise the first available Spotify client.
player=
for candidate in spotify_player spotify; do
    candidate_status=$(playerctl -p "$candidate" status 2>/dev/null) || continue
    if [ -z "$player" ] || [ "$candidate_status" = "Playing" ]; then
        player=$candidate
        status=$candidate_status
    fi
    [ "$candidate_status" = "Playing" ] && break
done

[ -n "$player" ] || exit 0

if [ "${1:-}" = "toggle" ]; then
    exec playerctl -p "$player" play-pause
fi

if [ -n "$status" ]; then
    artist=$(playerctl -p "$player" metadata artist 2>/dev/null)
    title=$(playerctl -p "$player" metadata title 2>/dev/null)
    
    if [ -n "$artist" ] && [ -n "$title" ]; then
        if [ "$status" = "Playing" ]; then
            color="%{F#f8f8f2}"
        else
            color="%{F#6272a4}"
        fi
        
        text="${title} - ${artist}"
        if [ ${#text} -gt $max_output_len ]; then
            text="${text:0:$((max_output_len-3))}..."
        fi
        echo "${color}${text}%{F-}"
    fi
fi
